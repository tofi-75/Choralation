# Copy to ignored .env.hosted. Never copy local database settings here.
# Values shown are placeholders, not working credentials.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-of-at-least-50-characters
DJANGO_DEBUG=false
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DJANGO_STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=sheet-music
AWS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=eu-central-1
AWS_ACCESS_KEY_ID=replace-with-private-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-private-storage-secret
ALLOW_HOSTED_DEMO_DATA=true
APP_TIME_ZONE=Asia/Beirut
