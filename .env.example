# Copy to .env; use a random SECRET_KEY of at least 50 characters.
DJANGO_SECRET_KEY=replace-with-a-random-development-secret-at-least-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Portable development PostgreSQL uses 55432; Compose publishes the same port.
DATABASE_URL=postgresql://choralation:replace-with-local-password@127.0.0.1:55432/choralation
TEST_DATABASE_NAME=test_choralation
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_TIME_ZONE=Asia/Beirut
# Optional public Maronite day-title feed; false keeps local season suggestions.
MARONITE_FEED_ENABLED=true
# Optional private PDF storage override; native default is project-local .local/media.
# DJANGO_MEDIA_ROOT=C:/path/to/private/media
# Used only by the optional Compose database; never commit real values.
POSTGRES_PASSWORD=replace-with-local-password

# Simple accounts: registration works without email delivery.
ACCOUNT_REGISTRATION_ENABLED=true
ACCOUNT_VERIFICATION_REQUIRED=false
APP_PUBLIC_URL=http://localhost:5173
# Development emails are written only beneath ignored .local/emails.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=Choralation <noreply@example.invalid>
ACCOUNT_EMAIL_DAILY_LIMIT=100
# Production: EMAIL_BACKEND=accounts.email_backend.GmailBackend
# GMAIL_CLIENT_ID=copy-privately
# GMAIL_CLIENT_SECRET=copy-privately
# GMAIL_REFRESH_TOKEN=copy-privately
ACCOUNT_EMAIL_VERIFICATION_ENABLED=false
ACCOUNT_PASSWORD_RESET_ENABLED=false
